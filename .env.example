# Copy to .env.local for local development. All values here are public (they ship in the bundle).
# Every value is optional: without a .env file the app talks to the live APIs.

# The Crispr candidate APIs. Default: https://crisprtech.app/crispr-apis
VITE_API_BASE=

# Candidate portal origin. Default: https://candidate.crisprlearning.com
VITE_PORTAL_URL=

# true = keep the login cookie on .crisprlearning.com so the portal sees it after payment.
# Read src/lib/auth.ts first: the portal's logout must clear that cookie too.
VITE_SHARED_LOGIN_COOKIE=

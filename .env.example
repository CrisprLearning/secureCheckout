# Copy to .env.local for local development. All values here are public (they ship in the bundle).

# Base URL of the checkout backend, for example https://api.securecheckout.crisprlearning.com
# Leave empty to run against the in-browser demo backend (no real login or payment).
VITE_API_BASE_URL=

# Candidate portal origin.
VITE_PORTAL_URL=https://candidate.crisprlearning.com

# WhatsApp help number, international format without "+".
VITE_WHATSAPP_NUMBER=
